# Public frontend configuration. NOURISH_SUPABASE_ANON_KEY accepts the browser-safe Supabase publishable key when RLS is configured correctly.
NOURISH_SUPABASE_URL=
NOURISH_SUPABASE_ANON_KEY=
NOURISH_BACKEND_FUNCTION_URL=

# Server-side only; configure as Supabase Edge Function secrets. Never expose these in frontend code.
GEMINI_API_KEY=
USDA_API_KEY=
ALLOWED_ORIGINS=
